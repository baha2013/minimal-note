{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minimal-note",
  "version": "1.0.0",
  "identifier": "com.minimalnote.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "المفكرة الذكية - Minimal Note",
        "width": 850,
        "height": 650,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
